@vqeaf 1.0

<theme id="split_gaze" name="Split Gaze">

    metadata {
        author: "Qeafivels Software"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    studio {
        orientation: "portrait"
        autoId: false
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.12
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#2B0A22"
        shellBottom: "#071626"
        shellBorder: "#FF2F7E"
        screen: "#04070C"
        key: "#1B2340"
        keyPressed: "#33204A"
        keyBorder: "#FF2F92"
        keyText: "#FFFFFF"
        subText: "#9FB8D8"
        accent: "#00C2FF"
        glow: "#FF0A5C"
    }

    metrics {
        shellRadius: 18dp
        keyRadius: 10dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: null
            opacity: 0.45
            fit: "cover"
            blend: "overlay"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.00
            saturation: 1.00
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.12
            frameFxBlend: "screen"
            floating: false
            floatAmplitude: 6dp
            floatDuration: 3200ms
            floatShadow: 30dp
        }
        
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keyStyle_0" type="button-style">
        target: "0"
        preset: "gaze_pale"
        shape {
            type: "capsule"
            radius: 14dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#FFFFFF", "#FFE8EE", "#D8A8BC" ]
            }
            stroke { width: 2dp color: "#FFFFFF" }
        }
        shadow { color: "#00000055" y: 4dp blur: 10dp }
        glow { color: "#FFD8E6" radius: 5dp }
        gloss { enabled: true opacity: 0.30 style: "top-arc" }
        text {
            color: "#400A25"
            outline: "#FFFFFF"
            outlineWidth: 1dp
            size: 14sp
            weight: 900
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#F2D8E0", "#B9889C" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.45
            saturation: 0.25
        </state>
    </component>

    <component id="keyStyle_1" type="button-style">
        target: "1"
        preset: "gaze_pink"
        shape {
            type: "capsule"
            radius: 14dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#FF6FA0", "#FF0A5C", "#B3003F" ]
            }
            stroke { width: 2dp color: "#FFE3EE" }
        }
        shadow { color: "#00000066" y: 4dp blur: 10dp }
        glow { color: "#FF2F92" radius: 7dp }
        gloss { enabled: true opacity: 0.32 style: "top-arc" }
        text {
            color: "#FFFFFF"
            outline: "#8A0030"
            outlineWidth: 1dp
            size: 14sp
            weight: 900
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
