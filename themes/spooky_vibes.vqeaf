@vqeaf 1.0

<theme id="spooky_vibes" name="Spooky Vibes">

    metadata {
        author: "DOXUANHOP"
        website: "https://qeafivels.com/"
        version: "1.0.0"
        description: "Theme Spooky Vibes - khung tim + vang dong, anh vao tung phim"
    }

    studio {
        orientation: "portrait"
        autoId: false
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.12
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#4B2B58"
        shellBottom: "#1B0D22"
        shellBorder: "#C9A227"
        screen: "#14110F"
        key: "#43284F"
        keyPressed: "#5E3A6E"
        keyBorder: "#C9A227"
        keyText: "#EDE3F7"
        subText: "#C9A227"
        accent: "#C9A227"
        glow: "#8A4FBF"
    }

    metrics {
        shellRadius: 20dp
        keyRadius: 9dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: null
            opacity: 0.45
            fit: "cover"
            blend: "overlay"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.00
            saturation: 1.00
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.12
            frameFxBlend: "screen"
            floating: false
            floatAmplitude: 6dp
            floatDuration: 3200ms
            floatShadow: 30dp
        }
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keyStyle_menu" type="button-style">
        target: "menu"
        preset: "spooky_ghost"
        shape {
            type: "square"
            radius: 6dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#FFFFFF", "#EDE9E4", "#B9B3AC" ]
            }
            stroke { width: 2dp color: "#141414" }
        }
        bevel { size: 2dp blur: 2dp color: "#FFFFFF" }
        shadow { color: "#00000066" y: 4dp blur: 8dp }
        glow { color: "#CFE6CF" radius: 3dp }
        gloss { enabled: true opacity: 0.32 style: "top-arc" }
        text {
            color: "#141414"
            outline: "#FFFFFF"
            outlineWidth: 1dp
            size: 14sp
            weight: 900
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#DAD5CE", "#948E88" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.42
            saturation: 0.20
        </state>
    </component>

    <component id="keyStyle_up" type="button-style">
        target: "up"
        preset: "spooky_gold"
        shape {
            type: "square"
            radius: 6dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#F5DE9A", "#D9B440", "#96701A" ]
            }
            stroke { width: 2dp color: "#2A1A08" }
        }
        bevel { size: 2dp blur: 2dp color: "#FFFFFF" }
        shadow { color: "#00000066" y: 4dp blur: 8dp }
        glow { color: "#FFE9A8" radius: 5dp }
        gloss { enabled: true opacity: 0.32 style: "top-arc" }
        text {
            color: "#2A1A08"
            outline: "#F5DE9A"
            outlineWidth: 1dp
            size: 14sp
            weight: 900
        }
        decoration { left: "star" right: "star" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#C9A227", "#7A5A10" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.42
            saturation: 0.20
        </state>
    </component>

