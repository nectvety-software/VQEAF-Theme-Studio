    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 0.50
            fit: "cover"
            blend: "normal"
            position: "above"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.05
            contrast: 1.14
            saturation: 1.25
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.10
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#4B2B58"
            stroke { width: 1dp color: "#C9A227" }
        }
        text {
            color: "#EDE3F7"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#C9A227"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#8A4FBF" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "glass"
        shape {
            radius: 18dp
            fill: "#1B0D22"
            stroke { width: 1dp color: "#C9A227" }
        }
        text {
            color: "#C9A227"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#C9A227"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#8A4FBF" radius: 6dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <resource id="keypad_background" type="image">
        name: "spooky_vibes_bg.jpg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <vector id="star">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FFD45A" data="M12,2 L15,9 L22,9 L16,13 L18,21 L12,16 L6,21 L8,13 L2,9 L9,9 Z"></path>
    </vector>

    <vector id="sparkle">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FFF3B0" data="M12,2 L13.5,10.5 L22,12 L13.5,13.5 L12,22 L10.5,13.5 L2,12 L10.5,10.5 Z"></path>
    </vector>

    <vector id="gem">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#B04BFF" data="M8,4 L16,4 L20,9 L12,20 L4,9 Z"></path>
    </vector>

    <vector id="ghost">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FFFFFF" data="M6,20 V10 C6,5 9,3 12,3 C16,3 18,6 18,10 V20 L15,18 L12,20 L9,18 Z"></path>
    </vector>

</theme>
