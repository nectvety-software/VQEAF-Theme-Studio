    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 0.32
            fit: "cover"
            blend: "normal"
            position: "above"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.04
            contrast: 1.10
            saturation: 1.12
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.10
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#FFF1CC"
            stroke { width: 1dp color: "#6B4226" }
        }
        text {
            color: "#4A2E10"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#E8443C"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FFD966" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "glass"
        shape {
            radius: 18dp
            fill: "#E0901E"
            stroke { width: 1dp color: "#6B4226" }
        }
        text {
            color: "#6B4226"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#E8443C"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FFD966" radius: 6dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <resource id="keypad_background" type="image">
        name: "pika_honey_bg.jpg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

