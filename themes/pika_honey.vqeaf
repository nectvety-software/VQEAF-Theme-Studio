@vqeaf 1.0

<theme id="pika_honey" name="Pika Honey">

    metadata {
        author: "DOXUANHOP"
        website: "https://qeafivels.com/"
        version: "1.0.0"
        description: "Theme Pika Honey - vang mat ong + nau, anh vao tung phim"
    }

    studio {
        orientation: "portrait"
        autoId: false
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.12
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#FFD24A"
        shellBottom: "#E0901E"
        shellBorder: "#6B4226"
        screen: "#241505"
        key: "#F7B733"
        keyPressed: "#E09A18"
        keyBorder: "#6B4226"
        keyText: "#3A2410"
        subText: "#6B4226"
        accent: "#E8443C"
        glow: "#FFD966"
    }

    metrics {
        shellRadius: 24dp
        keyRadius: 12dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: null
            opacity: 0.45
            fit: "cover"
            blend: "overlay"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.00
            saturation: 1.00
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.12
            frameFxBlend: "screen"
            floating: false
            floatAmplitude: 6dp
            floatDuration: 3200ms
            floatShadow: 30dp
        }
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keyStyle_menu" type="button-style">
        target: "menu"
        preset: "keycap"
        shape {
            type: "square"
            radius: 6dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#A8854F", "#936925", "#5A3D0F" ]
            }
            stroke { width: 0dp color: "#B39566" }
        }
        bevel { size: 2dp blur: 2dp color: "#FFFFFF" }
        shadow { color: "#00000066" y: 3dp blur: 6dp }
        glow { color: "#8C5F17" radius: 0dp }
        gloss { enabled: true opacity: 0.34 style: "top-arc" }
        text {
            color: "#FFFFFF"
            outline: "#000000"
            outlineWidth: 0dp
            size: 14sp
            weight: 900
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#48310C", "#322208" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.45
            saturation: 0.25
        </state>
    </component>

    <component id="keyStyle_up" type="button-style">
        target: "up"
        preset: "keycap"
        shape {
            type: "square"
            radius: 6dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#A8854F", "#936925", "#5A3D0F" ]
            }
            stroke { width: 0dp color: "#B39566" }
        }
        bevel { size: 2dp blur: 2dp color: "#FFFFFF" }
        shadow { color: "#00000066" y: 3dp blur: 6dp }
        glow { color: "#8C5F17" radius: 0dp }
        gloss { enabled: true opacity: 0.34 style: "top-arc" }
        text {
