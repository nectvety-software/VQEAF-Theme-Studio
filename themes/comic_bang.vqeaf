    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 0.38
            fit: "cover"
            blend: "soft-light"
            position: "below"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.00
            contrast: 1.08
            saturation: 1.05
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#B05229"
            stroke { width: 1dp color: "#141414" }
        }
        text {
            color: "#FBF0D4"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#F5382C"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#1D6FF2" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "glass"
        shape {
            radius: 18dp
            fill: "#281226"
            stroke { width: 1dp color: "#F2C732" }
        }
        text {
            color: "#FFE45E"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#F5382C"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#1D6FF2" radius: 6dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

