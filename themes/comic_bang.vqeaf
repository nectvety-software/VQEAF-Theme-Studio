@vqeaf 1.0

<theme id="comic_bang" name="Comic Bang">

    metadata {
        author: "DOXUANHOP"
        website: "https://qeafivels.com/"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    studio {
        orientation: "portrait"
        autoId: false
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.12
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#93296F"
        shellBottom: "#281226"
        shellBorder: "#F2C732"
        screen: "#1A0A18"
        key: "#B05229"
        keyPressed: "#D89618"
        keyBorder: "#141414"
        keyText: "#FBF0D4"
        subText: "#FFE45E"
        accent: "#F5382C"
        glow: "#1D6FF2"
    }

    metrics {
        shellRadius: 18dp
        keyRadius: 10dp
        keyBorder: 2dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: @frame_background
            opacity: 0.92
            fit: "cover"
            blend: "normal"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.02
            contrast: 1.05
            saturation: 1.08
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.12
            frameFxBlend: "screen"
            floating: false
            floatAmplitude: 6dp
            floatDuration: 3200ms
            floatShadow: 30dp
        }
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keyStyle_menu" type="button-style">
        target: "menu"
        preset: "comic_cream"
        shape {
            type: "capsule"
            radius: 10dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#FFF8E8", "#FBF0D4", "#D89618" ]
            }
            stroke { width: 3dp color: "#141414" }
        }
        shadow { color: "#00000077" y: 4dp blur: 6dp }
        glow { color: "#FFE45E" radius: 3dp }
        gloss { enabled: true opacity: 0.30 style: "top-arc" }
        text {
            color: "#281226"
            outline: "#FBF0D4"
            outlineWidth: 1dp
            size: 14sp
            weight: 900
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#F2E4B8", "#B87A10" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.40
            saturation: 0.20
        </state>
    </component>

    <component id="keyStyle_up" type="button-style">
        target: "up"
        preset: "pop_yellow"
        shape {
            type: "capsule"
            radius: 10dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#FFE45E", "#FFB800", "#E07B00" ]
            }
            stroke { width: 3dp color: "#141414" }
        }
        shadow { color: "#00000077" y: 4dp blur: 6dp }
        glow { color: "#FFF3B0" radius: 4dp }
        gloss { enabled: true opacity: 0.30 style: "top-arc" }
        text {
            color: "#231400"
            outline: "#FFFFFF"
            outlineWidth: 1dp
            size: 14sp
            weight: 900
        }
        decoration { left: "star" right: "star" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#F2C230", "#B45309" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.40
            saturation: 0.20
        </state>
    </component>

