@vqeaf 1.0

<theme id="ice" name="Ice Glass">

    metadata {
        author: "Qeafivels Software"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    studio {
        orientation: "portrait"
        autoId: true
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 1.00
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#203E56"
        shellBottom: "#0C1C2A"
        shellBorder: "#75B6D9"
        screen: "#07131B"
        key: "#244C68"
        keyPressed: "#3F7190"
        keyBorder: "#8AC8E5"
        keyText: "#F4FCFF"
        subText: "#AED6EA"
        accent: "#83F0D2"
        glow: "#8ADFFF"
    }

    metrics {
        shellRadius: 24dp
        keyRadius: 10dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: @frame_background
            opacity: 1.00
            fit: "cover"
            blend: "normal"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.00
            saturation: 1.00
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 1.00
            frameFxBlend: "screen"
            floating: true
            floatAmplitude: 6dp
            floatDuration: 4700ms
            floatShadow: 47dp
        }
        animation: @frame_float
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 1.00
            fit: "cover"
            blend: "soft-light"
            position: "above"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.00
            contrast: 1.08
            saturation: 1.00
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" extends="key">
        shape { radius: 18dp }
    </component>

    <component id="fpsBadge" extends="menuButton"></component>

    <component id="decoration_mu6b0gtsn4cc0" type="image">
        icon { source: @web size: 29dp tint: "#47EB81" }
        transform { translateX: 70dp translateY: 556dp rotation: -13deg scaleX: 1 scaleY: 1 }
        opacity: 0.97
        layer { zIndex: 0 }
        effect {
            floating: false
            floatAmplitude: 4dp
            floatDuration: 2500ms
        }
        
    </component>

    <resource id="keypad_background" type="image">
        name: "bb5e27f01755b0b4f316275c9dd2397a.jpg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <resource id="frame_background" type="image">
        name: "bb5e27f01755b0b4f316275c9dd2397a.jpg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <vector id="web">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path stroke="#DCC6FF" strokeWidth=1 fill="#00000000" data="M0,0 L24,24 M12,0 L12,24 M0,12 L24,12 M2,2 C9,8 15,8 22,2"></path>
    </vector>

    <animation id="frame_float">
        duration: 4700ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -6dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>



</theme>