@vqeaf 1.0

<theme id="default_nokia" name="Nokia Dark">

    metadata {
        author: "Qeafivels Software"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    studio {
        orientation: "portrait"
        autoId: true
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 1.00
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#2B3444"
        shellBottom: "#151C27"
        shellBorder: "#435069"
        screen: "#090D14"
        key: "#34445D"
        keyPressed: "#4E6C96"
        keyBorder: "#506685"
        keyText: "#FFFFFF"
        subText: "#9FB2CC"
        accent: "#65DC96"
        glow: "#00000000"
    }

    metrics {
        shellRadius: 20dp
        keyRadius: 6dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: @frame_background
            opacity: 1.00
            fit: "cover"
            blend: "normal"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.00
            saturation: 1.00
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 1.00
            frameFxBlend: "screen"
            floating: true
            floatAmplitude: 6dp
            floatDuration: 4700ms
            floatShadow: 47dp
        }
        animation: @frame_float
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 1.00
            fit: "cover"
            blend: "soft-light"
            position: "above"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.00
            contrast: 1.08
            saturation: 1.00
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "outline"
        shape {
            radius: 18dp
            fill: "#34445D"
            stroke { width: 1dp color: "#506685" }
        }
        text {
            color: "#FFFFFF"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#65DC96"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#00000000" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "outline"
        shape {
            radius: 18dp
            fill: "#151C27"
            stroke { width: 1dp color: "#435069" }
        }
        text {
            color: "#9FB2CC"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#65DC96"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#00000000" radius: 6dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="decoration_mu6b0gtsn4cc0" type="image">
        icon { source: @web size: 29dp tint: "#47EB81" }
        transform { translateX: -6dp translateY: 556dp rotation: -13deg scaleX: 1 scaleY: 1 }
        opacity: 0.97
        layer { zIndex: 0 }
        effect {
            floating: false
            floatAmplitude: 4dp
            floatDuration: 2500ms
        }
        
    </component>

    <resource id="keypad_background" type="image">
        name: "Rain_storm_in_Hanoi_street_2K_20260918100007.jpeg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <resource id="frame_background" type="image">
        name: "Rain_storm_in_Hanoi_street_2K_20260918100007.jpeg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <vector id="web">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path stroke="#DCC6FF" strokeWidth=1 fill="#00000000" data="M0,0 L24,24 M12,0 L12,24 M0,12 L24,12 M2,2 C9,8 15,8 22,2"></path>
    </vector>

    <animation id="frame_float">
        duration: 4700ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -6dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>



</theme>