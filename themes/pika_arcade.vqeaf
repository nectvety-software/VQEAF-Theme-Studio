    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 0.32
            fit: "cover"
            blend: "normal"
            position: "above"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.04
            contrast: 1.12
            saturation: 1.15
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.10
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#2C2C4A"
            stroke { width: 1dp color: "#FFD23F" }
        }
        text {
            color: "#FFD23F"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#3BB273"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FFD23F" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "glass"
        shape {
            radius: 18dp
            fill: "#8E0F24"
            stroke { width: 1dp color: "#FFD23F" }
        }
        text {
            color: "#FFE07A"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#3BB273"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FFD23F" radius: 6dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <resource id="keypad_background" type="image">
        name: "pika_arcade_bg.jpg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <vector id="star">
        width: 24dp
        height: 24dp
