    <animation id="decoration_float_bat">
        duration: 2600ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -5dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

    <animation id="decoration_float_ghost_top">
        duration: 2600ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -5dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

    <animation id="decoration_float_pumpkin_ok">
        duration: 2600ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -3dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

