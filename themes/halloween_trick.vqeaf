@vqeaf 1.0

<theme id="halloween_trick" name="Halloween Trick">

    metadata {
        author: "DOXUANHOP"
        website: "https://qeafivels.com/"
        version: "1.0.0"
        description: "Halloween Trick - Nokia 225 frame (original art, no third-party logos)"
    }

    studio {
        orientation: "portrait"
        autoId: false
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.12
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#26262B"
        shellBottom: "#050507"
        shellBorder: "#9CA3AF"
        screen: "#C9710C"
        key: "#111114"
        keyPressed: "#2A2A30"
        keyBorder: "#D1D5DB"
        keyText: "#FFFFFF"
        subText: "#FF9A1F"
        accent: "#FF8A00"
        glow: "#FF8A00"
    }

    metrics {
        shellRadius: 24dp
        keyRadius: 10dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: @frame_background
            opacity: 0.95
            fit: "cover"
            blend: "normal"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.05
            saturation: 1.00
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.12
            frameFxBlend: "screen"
            floating: false
            floatAmplitude: 6dp
            floatDuration: 3200ms
            floatShadow: 30dp
        }
        
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keyStyle_0" type="button-style">
        target: "0"
        preset: "keycap"
        shape {
            type: "square"
            radius: 6dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#434345", "#171719", "#050506" ]
            }
            stroke { width: 0dp color: "#5C5C5D" }
        }
        bevel { size: 2dp blur: 2dp color: "#FFFFFF" }
        shadow { color: "#00000066" y: 3dp blur: 6dp }
        glow { color: "#08080A" radius: 0dp }
        gloss { enabled: true opacity: 0.34 style: "top-arc" }
        text {
            color: "#FFFFFF"
            outline: "#000000"
            outlineWidth: 0dp
            size: 14sp
            weight: 900
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#040405", "#030303" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.45
            saturation: 0.25
        </state>
    </component>

