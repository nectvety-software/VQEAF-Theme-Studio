    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 0.50
            fit: "cover"
            blend: "soft-light"
            position: "below"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.00
            contrast: 1.10
            saturation: 1.00
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#1A1A1F"
            stroke { width: 1dp color: "#FF8A00" }
        }
        text {
            color: "#FFB04D"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#FF8A00"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FF8A00" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "glass"
        shape {
            radius: 18dp
            fill: "#050507"
            stroke { width: 1dp color: "#9CA3AF" }
        }
        text {
            color: "#FF9A1F"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#FF8A00"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FF8A00" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="decoration_bat" type="image">
        icon { source: @bat size: 56dp tint: "#2B2B5E" }
        transform { translateX: 108dp translateY: 10dp rotation: 0deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 1 }
        effect {
            floating: true
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        animation: @decoration_float_bat
    </component>

