@vqeaf 1.0

<theme id="classic_sheet" name="Classic Sheet">

    metadata {
        author: "DOXUANHOP"
        website: "https://qeafivels.com/"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    studio {
        orientation: "portrait"
        autoId: false
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.12
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#D3CCC6"
        shellBottom: "#645F59"
        shellBorder: "#AEA79F"
        screen: "#1A1816"
        key: "#E0D8D0"
        keyPressed: "#C4BDB6"
        keyBorder: "#9D968E"
        keyText: "#2A2622"
        subText: "#645F59"
        accent: "#3E3A36"
        glow: "#00000000"
    }

    metrics {
        shellRadius: 22dp
        keyRadius: 8dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: @frame_background
            opacity: 0.55
            fit: "cover"
            blend: "soft-light"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.05
            contrast: 0.95
            saturation: 0.70
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.12
            frameFxBlend: "screen"
            floating: false
            floatAmplitude: 6dp
            floatDuration: 3200ms
            floatShadow: 30dp
        }
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keyStyle_menu" type="button-style">
        target: "menu"
        preset: "classic_warm"
        shape {
            type: "capsule"
            radius: 8dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#EDE6DF", "#C8BFB6", "#9D968E" ]
            }
            stroke { width: 1dp color: "#645F59" }
        }
        shadow { color: "#00000044" y: 3dp blur: 5dp }
        glow { color: "#00000000" radius: 0dp }
        gloss { enabled: false opacity: 0.00 style: "top-arc" }
        text {
            color: "#FFFFFF"
            outline: "#4A453F"
            outlineWidth: 1dp
            size: 13sp
            weight: 800
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#D5CCC4", "#8A837C" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.45
            saturation: 0.20
        </state>
    </component>

    <component id="keyStyle_up" type="button-style">
        target: "up"
        preset: "classic_soft"
        shape {
            type: "capsule"
            radius: 8dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#F5F0EB", "#E0D8D0", "#C4BDB6" ]
            }
            stroke { width: 1dp color: "#9D968E" }
        }
        shadow { color: "#00000033" y: 2dp blur: 4dp }
        glow { color: "#00000000" radius: 0dp }
        gloss { enabled: true opacity: 0.18 style: "top-arc" }
        text {
            color: "#2A2622"
            outline: "#F5F0EB"
            outlineWidth: 1dp
            size: 13sp
            weight: 800
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#D8D0C8", "#AEA79F" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.50
            saturation: 0.15
        </state>
    </component>

