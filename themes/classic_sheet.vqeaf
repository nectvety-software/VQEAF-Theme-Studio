    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 0.22
            fit: "cover"
            blend: "soft-light"
            position: "below"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.02
            contrast: 0.98
            saturation: 0.75
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#E0D8D0"
            stroke { width: 1dp color: "#9D968E" }
        }
        text {
            color: "#2A2622"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#3E3A36"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#00000000" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "glass"
        shape {
            radius: 18dp
            fill: "#645F59"
            stroke { width: 1dp color: "#AEA79F" }
        }
        text {
            color: "#E0D8D0"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#3E3A36"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#00000000" radius: 6dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <resource id="keypad_background" type="image">
        name: "classic_sheet_bg.jpg"
        mime: "image/jpeg"
        encoding: "data-uri"
        data: "data:image/jpeg;base64,"
    </resource>

    <resource id="frame_background" type="image">
        name: "classic_sheet_bg.jpg"
        mime: "image/jpeg"
        encoding: "data-uri"
        data: "data:image/jpeg;base64,"
    </resource>



</theme>
