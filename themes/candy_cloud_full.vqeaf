        transform { translateX: 236dp translateY: 330dp rotation: 0deg scaleX: 1 scaleY: 1 }
        opacity: 0.95
        layer { zIndex: 2 }
        effect {
            floating: false
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        
    </component>

    <component id="decoration_deco_leaf" type="image">
