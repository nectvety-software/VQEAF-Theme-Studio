@vqeaf 1.0

<theme id="candy_cloud_full" name="Candy Cloud Full">

    metadata {
        author: "Qeafivels Software"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    studio {
        orientation: "portrait"
        autoId: false
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.10
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#7A6A9E"
        shellBottom: "#3A3358"
        shellBorder: "#E8D8F5"
        screen: "#141428"
        key: "#6A5A94"
        keyPressed: "#8676B8"
        keyBorder: "#D8C8F0"
        keyText: "#FFFFFF"
        subText: "#E4D8F5"
        accent: "#FFB13B"
        glow: "#FF9BC5"
    }

    metrics {
        shellRadius: 22dp
        keyRadius: 12dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: null
            opacity: 0.60
            fit: "cover"
            blend: "soft-light"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.00
            saturation: 1.10
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.10
            frameFxBlend: "screen"
            floating: false
            floatAmplitude: 6dp
            floatDuration: 3200ms
            floatShadow: 30dp
        }
        
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keyStyle_0" type="button-style">
        target: "0"
        preset: "ice_glass"
        shape {
            type: "capsule"
            radius: 20dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#D8F5FF", "#88D8FB", "#3A9ED8" ]
            }
            stroke { width: 2dp color: "#F2FCFF" }
        }
        shadow { color: "#00000044" y: 4dp blur: 12dp }
        glow { color: "#A8EBFF" radius: 7dp }
        gloss { enabled: true opacity: 0.58 style: "top-arc" }
        text {
            color: "#FFFFFF"
            outline: "#2B82BA"
            outlineWidth: 1dp
            size: 14sp
            weight: 900
        }
        decoration { left: "cloud" right: "sparkle" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#9ED8F1", "#3389BC" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.45
            saturation: 0.22
        </state>
    </component>

    <component id="keyStyle_1" type="button-style">
        target: "1"
        preset: "candy_green"
        shape {
            type: "capsule"
            radius: 18dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#B9F58E", "#60C95D", "#48A94B" ]
            }
            stroke { width: 2dp color: "#E8FFD9" }
        }
        shadow { color: "#00000055" y: 4dp blur: 10dp }
        glow { color: "#A8FF92" radius: 5dp }
        gloss { enabled: true opacity: 0.48 style: "top-arc" }
        text {
            color: "#FFFFFF"
            outline: "#3C9143"
            outlineWidth: 1dp
            size: 14sp
            weight: 900
        }
        decoration { left: "leaf" right: "flower" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#8BDE6E", "#409744" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.45
            saturation: 0.25
        </state>
    </component>

