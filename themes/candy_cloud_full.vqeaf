    <animation id="decoration_float_deco_star">
        duration: 2600ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -5dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

    <animation id="decoration_float_deco_flower">
        duration: 3000ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -4dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

    <animation id="decoration_float_deco_gem">
        duration: 2800ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -6dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

    <animation id="decoration_float_deco_slime">
        duration: 2400ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -5dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

</theme>