    <component id="keypad" type="container">
        background {
            source: null
            opacity: 0.35
            fit: "cover"
            blend: "soft-light"
            position: "above"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.05
            contrast: 1.10
            saturation: 1.10
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#6A5A94"
            stroke { width: 1dp color: "#D8C8F0" }
        }
        text {
            color: "#FFFFFF"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#FFB13B"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FF9BC5" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "glass"
        shape {
            radius: 18dp
            fill: "#3A3358"
            stroke { width: 1dp color: "#E8D8F5" }
        }
        text {
            color: "#E4D8F5"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#FFB13B"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FF9BC5" radius: 6dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="decoration_deco_star" type="image">
        icon { source: @star size: 18dp tint: "#FFD45A" }
        transform { translateX: 0dp translateY: 8dp rotation: 0deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 0 }
        effect {
            floating: true
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        animation: @decoration_float_deco_star
    </component>

    <component id="decoration_deco_flower" type="image">
