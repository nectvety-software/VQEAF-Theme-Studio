    <vector id="star">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FFD45A" data="M12,2 L15,9 L22,9 L16,13 L18,21 L12,16 L6,21 L8,13 L2,9 L9,9 Z"></path>
    </vector>

    <vector id="flower">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FF9BC5" data="M12,4 C10,4 9,6 9,8 C7,8 5,9 5,11 C5,13 7,14 9,14 C9,16 10,18 12,18 C14,18 15,16 15,14 C17,14 19,13 19,11 C19,9 17,8 15,8 C15,6 14,4 12,4 Z"></path>
    </vector>

    <vector id="cloud">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#D8F5FF" data="M7,18 C4,18 3,16 3,14 C3,12 5,11 6,11 C7,8 9,7 12,7 C15,7 17,9 17,11 C19,11 21,12 21,14 C21,16 20,18 17,18 Z"></path>
    </vector>

    <vector id="leaf">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#6EDB91" data="M5,19 C5,11 11,5 19,5 C19,13 13,19 5,19 Z"></path>
    </vector>

    <vector id="gem">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#B04BFF" data="M8,4 L16,4 L20,9 L12,20 L4,9 Z"></path>
