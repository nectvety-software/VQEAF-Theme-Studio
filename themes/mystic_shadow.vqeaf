@vqeaf 1.0

<theme id="mystic_shadow" name="Mystic Shadow">

    metadata {
        author: "Qeafivels Software"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    studio {
        orientation: "portrait"
        autoId: true
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.21
        frameFxBlend: "overlay"
    }

    palette {
        shellTop: "#28341D"
        shellBottom: "#11160D"
        shellBorder: "#649E2E"
        screen: "#100910"
        key: "#28361C"
        keyPressed: "#487E2A"
        keyBorder: "#77DC18"
        keyText: "#FFFFFF"
        subText: "#BFCFAF"
        accent: "#6070EB"
        glow: "#89F623"
    }

    metrics {
        shellRadius: 26dp
        keyRadius: 10dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: @frame_background
            opacity: 1.00
            fit: "cover"
            blend: "normal"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.00
            saturation: 1.00
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.21
            frameFxBlend: "overlay"
            floating: false
            floatAmplitude: 4dp
            floatDuration: 4000ms
            floatShadow: 22dp
        }
        
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 1.00
            fit: "cover"
            blend: "soft-light"
            position: "above"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.50
            contrast: 1.60
            saturation: 2.00
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.25
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" extends="key">
        shape { radius: 18dp }
    </component>

    <component id="fpsBadge" extends="menuButton"></component>

    <component id="decoration_mu69v76fxfvl0" type="image">
        icon { source: @web size: 36dp tint: "#77DC18" }
        transform { translateX: 85dp translateY: 330dp rotation: -17deg scaleX: 1 scaleY: 1 }
        opacity: 0.97
        layer { zIndex: 0 }
        effect {
            floating: true
            floatAmplitude: 5dp
            floatDuration: 3000ms
        }
        animation: @decoration_float_mu69v76fxfvl0
    </component>

    <resource id="keypad_background" type="image">
        name: "cut_2-removebg-preview.png"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <resource id="frame_background" type="image">
        name: "08301671-39ce-41c4-bb1a-029e58cde5c9.jpg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <vector id="web">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path stroke="#DCC6FF" strokeWidth=1 fill="#00000000" data="M0,0 L24,24 M12,0 L12,24 M0,12 L24,12 M2,2 C9,8 15,8 22,2"></path>
    </vector>



    <animation id="decoration_float_mu69v76fxfvl0">
        duration: 3000ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -5dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

</theme>