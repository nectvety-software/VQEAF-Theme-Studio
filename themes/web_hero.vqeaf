    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 0.55
            fit: "cover"
            blend: "soft-light"
            position: "below"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.00
            contrast: 1.08
            saturation: 1.05
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#C8101E"
            stroke { width: 1dp color: "#FFB3B8" }
        }
        text {
            color: "#FFFFFF"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#FFFFFF"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FF4A55" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "glass"
        shape {
            radius: 18dp
            fill: "#081440"
            stroke { width: 1dp color: "#E82634" }
        }
        text {
            color: "#FFB3B8"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#E82634"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#FF4A55" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="decoration_logo" type="image">
        icon { source: @sparkle size: 34dp tint: "#FFD84A" }
        transform { translateX: 90dp translateY: 18dp rotation: 0deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 1 }
        effect {
            floating: true
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        animation: @decoration_float_logo
    </component>

    <component id="decoration_spider_top" type="image">
        icon { source: @spider size: 44dp tint: "#E82634" }
        transform { translateX: 212dp translateY: 14dp rotation: -12deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 1 }
        effect {
            floating: false
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        
    </component>

    <component id="decoration_spider_lcd" type="image">
        icon { source: @spider size: 34dp tint: "#FFFFFF" }
        transform { translateX: 6dp translateY: 226dp rotation: 0deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 1 }
        effect {
            floating: true
            floatAmplitude: 3dp
            floatDuration: 2600ms
        }
        animation: @decoration_float_spider_lcd
    </component>

    <component id="decoration_web_ok" type="image">
        icon { source: @heart size: 44dp tint: "#E82634" }
        transform { translateX: 112dp translateY: 262dp rotation: 0deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 1 }
        effect {
            floating: false
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        
    </component>

    <component id="decoration_bam_l" type="image">
        icon { source: @bam size: 34dp tint: "#FFD84A" }
        transform { translateX: 74dp translateY: 262dp rotation: -8deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 1 }
        effect {
            floating: false
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        
    </component>

    <component id="decoration_bam_r" type="image">
        icon { source: @bam size: 34dp tint: "#FFD84A" }
        transform { translateX: 166dp translateY: 262dp rotation: 8deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 1 }
        effect {
            floating: false
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        
    </component>

    <component id="decoration_spider_btm" type="image">
        icon { source: @spider size: 40dp tint: "#FFFFFF" }
        transform { translateX: 8dp translateY: 512dp rotation: 0deg scaleX: 1 scaleY: 1 }
        opacity: 1.00
        layer { zIndex: 1 }
        effect {
            floating: false
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        
    </component>

    <resource id="keypad_background" type="image">
        name: "web_hero_keys.webp"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <resource id="frame_background" type="image">
        name: "web_hero_frame.webp"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <vector id="sparkle">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FFD84A" data="M12,2 L13.5,10.5 L22,12 L13.5,13.5 L12,22 L10.5,13.5 L2,12 L10.5,10.5 Z"></path>
    </vector>

    <vector id="spider">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FFFFFF" data="M12,8 C14,8 15.5,9.5 15.5,12 C15.5,15 14,17 12,17 C10,17 8.5,15 8.5,12 C8.5,9.5 10,8 12,8 Z M12,3.5 C13,3.5 13.8,4.3 13.8,5.3 C13.8,6.3 13,7.1 12,7.1 C11,7.1 10.2,6.3 10.2,5.3 C10.2,4.3 11,3.5 12,3.5 Z M9,10 L2,5 M9,12 L1,12 M9,14 L2,19 M10,16 L5,22 M15,10 L22,5 M15,12 L23,12 M15,14 L22,19 M14,16 L19,22"></path>
    </vector>

    <vector id="heart">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#E82634" data="M12,21 C5,15 2,11 2,7.5 C2,4.5 4.3,3 6.8,3 C9,3 11,4.2 12,6 C13,4.2 15,3 17.2,3 C19.7,3 22,4.5 22,7.5 C22,11 19,15 12,21 Z"></path>
    </vector>

    <vector id="bam">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FFD84A" data="M12,1 L14.5,7 L21,4 L18.5,10.5 L23,13 L17,15 L19,22 L12.5,18 L8,23 L7.5,16 L1,16 L6.5,12 L2,7 L9,8 Z"></path>
    </vector>



    <animation id="decoration_float_logo">
        duration: 2600ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -5dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

    <animation id="decoration_float_spider_lcd">
        duration: 2600ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -3dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

</theme>