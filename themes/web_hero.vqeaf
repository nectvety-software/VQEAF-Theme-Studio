@vqeaf 1.0

<theme id="web_hero" name="Web Hero">

    metadata {
        author: "DOXUANHOP"
        website: "https://qeafivels.com/"
        version: "1.0.0"
        description: "Web Hero - Nokia 225 frame (original art, no third-party logos)"
    }

    studio {
        orientation: "portrait"
        autoId: false
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.12
        frameFxBlend: "screen"
    }

    palette {
        shellTop: "#10256A"
        shellBottom: "#081440"
        shellBorder: "#E82634"
        screen: "#6F8B2A"
        key: "#C8101E"
        keyPressed: "#8E0A14"
        keyBorder: "#FFB3B8"
        keyText: "#FFFFFF"
        subText: "#FFB3B8"
        accent: "#E82634"
        glow: "#FF4A55"
    }

    metrics {
        shellRadius: 24dp
        keyRadius: 10dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: @frame_background
            opacity: 0.95
            fit: "cover"
            blend: "normal"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.02
            saturation: 1.05
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.12
            frameFxBlend: "screen"
            floating: false
            floatAmplitude: 6dp
            floatDuration: 3200ms
            floatShadow: 30dp
        }
        
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="keyStyle_0" type="button-style">
        target: "0"
        preset: "keycap"
        shape {
            type: "square"
            radius: 6dp
            fill {
                type: linear
                angle: 180deg
                colors: [ "#73495D", "#521D37", "#2D0A1B" ]
            }
            stroke { width: 0dp color: "#866172" }
        }
        bevel { size: 2dp blur: 2dp color: "#FFFFFF" }
        shadow { color: "#00000066" y: 3dp blur: 6dp }
        glow { color: "#470F2A" radius: 0dp }
        gloss { enabled: true opacity: 0.34 style: "top-arc" }
        text {
            color: "#FFFFFF"
            outline: "#000000"
            outlineWidth: 0dp
            size: 14sp
            weight: 900
        }
        decoration { left: "none" right: "none" }
        <state name="pressed">
            fill { type: linear angle: 180deg colors: [ "#240816", "#19060F" ] }
            transform { scale: 0.96 }
        </state>
        <state name="disabled">
            opacity: 0.45
            saturation: 0.25
        </state>
    </component>

