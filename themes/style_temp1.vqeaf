@vqeaf 1.0

<theme id="halloween_neon" name="Halloween Neon">

    metadata {
        author: "Qeafivels Software"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    palette {
        shellTop: "#211226"
        shellBottom: "#080911"
        shellBorder: "#7C3719"
        screen: "#04070C"
        key: "#5C4A5E"
        keyPressed: "#4F1527"
        keyBorder: "#FF0088"
        keyText: "#11FF00"
        subText: "#D58450"
        accent: "#63E6A2"
        glow: "#FF5A00"
    }

    metrics {
        shellRadius: 22dp
        keyRadius: 7dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" extends="key">
        shape { radius: 18dp }
    </component>

    <component id="fpsBadge" extends="menuButton"></component>

    <component id="decoration_mu5i0917" type="image">
        icon { source: @pumpkin size: 28dp tint: "#FFB13B" }
        transform { translateX: 26dp translateY: 244dp rotation: 0deg }
        opacity: 1
    </component>

    <component id="decoration_mu5i0my3" type="image">
        icon { source: @bat size: 28dp tint: "#FFB13B" }
        transform { translateX: 233dp translateY: 7dp rotation: 0deg }
        opacity: 1
    </component>

    <vector id="pumpkin">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#FF7A18" data="M12,4 C7,4 4,8 4,13 C4,18 7,21 12,21 C17,21 20,18 20,13 C20,8 17,4 12,4 Z"/>
    </vector>

    <vector id="bat">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#151018" data="M2,9 L7,6 L10,9 L12,6 L14,9 L17,6 L22,9 L18,15 L14,13 L12,18 L10,13 L6,15 Z"/>
    </vector>

</theme>