@vqeaf 1.0

<theme id="92687154_dream_pulse" name="92687154 Dream Pulse">

    metadata {
        author: "DOXUANHOP"
        website: "https://qeafivels.com/"
        version: "1.0.0"
        description: "Theme created with VQEAF Theme Studio"
    }

    studio {
        orientation: "portrait"
        autoId: true
        layerOrder: [ "frameBackground", "frameFx", "screen", "keypad", "decorations", "network", "badges" ]
        frameFxOpacity: 0.16
        frameFxBlend: "soft-light"
    }

    palette {
        shellTop: "#41253C"
        shellBottom: "#1A0F16"
        shellBorder: "#C238A8"
        screen: "#09100E"
        key: "#43233D"
        keyPressed: "#6B2454"
        keyBorder: "#E830C6"
        keyText: "#FFFFFF"
        subText: "#CDACC7"
        accent: "#69EAEC"
        glow: "#F628D0"
    }

    metrics {
        shellRadius: 24dp
        keyRadius: 8dp
        keyBorder: 1dp
    }

    <component id="phoneShell" type="container">
        shape {
            type: rect
            radius: $metrics.shellRadius
            fill {
                type: linear
                angle: 180deg
                colors: [ $palette.shellTop, $palette.shellBottom ]
            }
            stroke { width: 1.5dp color: $palette.shellBorder }
        }
        background {
            source: @frame_background
            opacity: 1.00
            fit: "cover"
            blend: "normal"
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
            brightness: 1.00
            contrast: 1.00
            saturation: 1.00
            clipToFrameShape: true
            raised: false
            rotation: 0deg
            scaleX: 1
            scaleY: 1
        }
        effect {
            frameFxOpacity: 0.16
            frameFxBlend: "soft-light"
            floating: true
            floatAmplitude: 6dp
            floatDuration: 3400ms
            floatShadow: 45dp
        }
        animation: @frame_float
    </component>

    <component id="screen" type="panel">
        shape { radius: 4dp fill: $palette.screen }
    </component>

    <component id="key" type="button">
        shape {
            radius: $metrics.keyRadius
            fill: $palette.key
            stroke { width: $metrics.keyBorder color: $palette.keyBorder }
        }
        text { color: $palette.keyText weight: 700 align: center }
        glow { color: $palette.glow radius: 12dp strength: 0.75 }
        <state name="pressed">
            shape { fill: $palette.keyPressed }
            transform { scale: 0.98 }
        </state>
    </component>



    <component id="keypad" type="container">
        background {
            source: @keypad_background
            opacity: 1.00
            fit: "cover"
            blend: "soft-light"
            position: "above"
            renderMode: "per-key-texture"
            textureMode: "per-key"
            brightness: 1.00
            contrast: 1.08
            saturation: 1.00
            readabilityAssist: true
            rotation: 0deg
            scaleX: 1
            scaleY: 1
            scale: 1.00
            offsetX: 0dp
            offsetY: 0dp
            blur: 0dp
        }
    </component>

    <component id="networkLed" type="view">
        shape { fill: $palette.accent radius: 99dp }
    </component>

    <component id="menuButton" type="badge">
        appearance: "solid"
        shape {
            radius: 18dp
            fill: "#43233D"
            stroke { width: 1dp color: "#E830C6" }
        }
        text {
            color: "#FFFFFF"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#69EAEC"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#F628D0" radius: 8dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="fpsBadge" type="badge">
        appearance: "neon"
        shape {
            radius: 18dp
            fill: "#1A0F16"
            stroke { width: 1dp color: "#C238A8" }
        }
        text {
            color: "#CDACC7"
            size: 11sp
            weight: 800
            letterSpacing: 0.04
            uppercase: true
        }
        indicator {
            color: "#69EAEC"
            size: 6dp
            glow: 8dp
        }
        glow { color: "#F628D0" radius: 6dp }
        shadow { blur: 18dp }
        opacity: 1.00
        padding { horizontal: 13dp vertical: 11dp }
    </component>

    <component id="decoration_mu6kcsq8xjc00" type="image">
        icon { source: @web size: 30dp tint: "#CBE82C" }
        transform { translateX: 18dp translateY: 228dp rotation: -21deg scaleX: 1 scaleY: 1 }
        opacity: 0.94
        layer { zIndex: 0 }
        effect {
            floating: true
            floatAmplitude: 6dp
            floatDuration: 3100ms
        }
        animation: @decoration_float_mu6kcsq8xjc00
    </component>

    <component id="decoration_mu6kcsq8icl01" type="image">
        icon { source: @badge size: 31dp tint: "#CBE82C" }
        transform { translateX: 52dp translateY: 85dp rotation: 19deg scaleX: 1 scaleY: 1 }
        opacity: 0.97
        layer { zIndex: 1 }
        effect {
            floating: false
            floatAmplitude: 5dp
            floatDuration: 2600ms
        }
        
    </component>

    <component id="decoration_mu6kcsq8d1o02" type="image">
        icon { source: @leaf size: 20dp tint: "#CBE82C" }
        transform { translateX: 143dp translateY: 41dp rotation: 13deg scaleX: 1 scaleY: 1 }
        opacity: 0.96
        layer { zIndex: 2 }
        effect {
            floating: true
            floatAmplitude: 7dp
            floatDuration: 1900ms
        }
        animation: @decoration_float_mu6kcsq8d1o02
    </component>

    <resource id="keypad_background" type="image">
        name: "08301671-39ce-41c4-bb1a-029e58cde5c9.jpg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <resource id="frame_background" type="image">
        name: "08301671-39ce-41c4-bb1a-029e58cde5c9.jpg"
        mime: "image/webp"
        encoding: "data-uri"
        data: "data:image/webp;base64,"
    </resource>

    <vector id="web">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path stroke="#DCC6FF" strokeWidth=1 fill="#00000000" data="M0,0 L24,24 M12,0 L12,24 M0,12 L24,12 M2,2 C9,8 15,8 22,2"></path>
    </vector>

    <vector id="badge">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#65DC96" data="M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3"></path>
    </vector>

    <vector id="leaf">
        width: 24dp
        height: 24dp
        viewportWidth: 24
        viewportHeight: 24
        <path fill="#6EDB91" data="M5,19 C5,11 11,5 19,5 C19,13 13,19 5,19 Z"></path>
    </vector>

    <animation id="frame_float">
        duration: 3400ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -6dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

    <animation id="decoration_float_mu6kcsq8xjc00">
        duration: 3100ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -6dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

    <animation id="decoration_float_mu6kcsq8d1o02">
        duration: 1900ms
        loop: true
        easing: easeInOut
        frames: [
            { at: 0% transform { translateY: 0dp } },
            { at: 50% transform { translateY: -7dp } },
            { at: 100% transform { translateY: 0dp } }
        ]
    </animation>

</theme>